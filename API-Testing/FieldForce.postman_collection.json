              "\r",
              "pm.test(\"Customer created successfully\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.Status).to.eql(200);\r",
              "    pm.expect(response.Message).to.eql(\"Success\");\r",
              "});\r",
              "\r",
              "pm.test(\"Customer ID is generated\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.data.Id).to.exist;\r",
              "});"
